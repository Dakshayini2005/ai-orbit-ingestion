# Copy this file to .env and fill in what you have.
# Every credential below is OPTIONAL — the pipeline runs (in demo/fallback
# mode per-source) without any of them. See README.md "Demo mode" section.

GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
YOUTUBE_API_KEY=

# --- optional tuning ---
# REQUEST_TIMEOUT_SECONDS=15
# MAX_RETRIES=4
# BACKOFF_BASE_SECONDS=1.0
# FUZZY_MATCH_THRESHOLD=90
# RESOLUTION_CONFIDENCE_FLOOR=0.80
# TARGET_MIN_RECORDS=250
# TARGET_MAX_RECORDS=300
# GITHUB_MAX_REPOS=60
# HUGGINGFACE_MAX_MODELS=60
# YOUTUBE_MAX_VIDEOS=40
# RSS_MAX_ITEMS_PER_FEED=15
# LOG_LEVEL=INFO
#
# Comma-separated overrides:
# GITHUB_SEARCH_QUERIES=topic:llm stars:>500,topic:machine-learning stars:>1000
# RSS_FEED_URLS=https://openai.com/news/rss.xml,https://huggingface.co/blog/feed.xml
